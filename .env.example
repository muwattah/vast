# Database
DATABASE_URL=sqlite:///./data/antwerp_properties.db

# AI Keys (backend only - NEVER expose to frontend)
OPENAI_API_KEY=sk-...
GROK_API_KEY=xai-...

# App settings
ENVIRONMENT=development
MAX_PRICE=800000
MIN_AREA=50
TARGET_POSTCODES=2000,2018,2020,2030,2040,2050,2060,2100,2140,2150,2160,2170,2180,2600,2610,2620,2630,2640,2650,2660
AI_SCORE_THRESHOLD=6.0
RENOVATION_COST_LIGHT_MIN=300
RENOVATION_COST_LIGHT_MAX=600
RENOVATION_COST_MEDIUM_MIN=600
RENOVATION_COST_MEDIUM_MAX=1000
RENOVATION_COST_HEAVY_MIN=1000
RENOVATION_COST_HEAVY_MAX=1500

# Scraper
SCRAPE_RATE_LIMIT_SECONDS=2.0
ENABLE_SCRAPERS=false
USE_DEMO_DATA=true
